{
  "name": "week",
  "theme": "living_sky",
  "transition": "crossfade",
  "scene": { "horizon": "high", "seed": 21 },
  "data_sources": [
    { "name": "weather", "type": "integration", "refresh": 3600 },
    { "name": "calendar", "type": "integration", "inputs": { "action": "list_upcoming_events", "since": "today", "max_results": 50 }, "refresh": 600 },
    { "name": "week", "type": "static", "value": { "summary": "" } }
  ],
  "layout": {
    "type": "zones",
    "children": [
      {
        "type": "zone",
        "place": "sky",
        "children": [
          { "type": "cal_header", "range": "week", "events": "{calendar.events}", "start": "{args.start}", "text": "{week.summary}" }
        ]
      },
      {
        "type": "zone",
        "place": "sky-right",
        "children": [
          { "type": "legend" }
        ]
      },
      {
        "type": "surface",
        "dock": "bottom",
        "children": [
          { "type": "week_grid", "events": "{calendar.events}", "forecast": "{weather.forecast}", "start": "{args.start}", "max_per_day": 5 }
        ]
      }
    ]
  }
}
